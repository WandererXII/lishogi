{
  "name": "common",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./abstract/*": {
      "sass": "./style/abstract/_*.scss"
    },
    "./base/*": {
      "sass": "./style/base/_*.scss"
    },
    "./component/*": {
      "sass": "./style/component/_*.scss"
    },
    "./form/*": {
      "sass": "./style/form/_*.scss"
    },
    "./header/*": {
      "sass": "./style/header/_*.scss"
    },
    "./layout/*": {
      "sass": "./style/layout/_*.scss"
    },
    "./shogiground/*": {
      "sass": "./style/shogiground/_*.scss"
    },
    "./vendor/*": {
      "sass": "./style/vendor/_*.scss"
    },
    "./theme": {
      "sass": "./style/theme/generated/_theme.scss"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "sass": "./style/_*.scss"
    }
  },
  "dependencies": {
    "breakpoint-sass": "catalog:",
    "shogiground": "catalog:",
    "shogiops": "catalog:",
    "snabbdom": "catalog:"
  }
}
